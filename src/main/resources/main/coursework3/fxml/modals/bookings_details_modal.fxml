<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20.0" styleClass="modal-window" stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.coursework3.controllers.modals.BookingDetailsController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Деталі бронювання" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="18.0"/>
        </font>
    </Label>

    <GridPane hgap="10.0" vgap="15.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="130.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0"/>
        </columnConstraints>

        <Label text="Клієнт:" GridPane.rowIndex="0">
            <font>
                <Font size="14.0"/>
            </font>
        </Label>
        <HBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <ComboBox fx:id="cmbClient" maxWidth="1.7976931348623157E308" prefWidth="203.0"
                      promptText="Оберіть клієнта..." HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAddNewClient" mnemonicParsing="false" prefHeight="25.0" prefWidth="31.0"
                    styleClass="btn-action" text="+"/>
        </HBox>
        <Label text="Кімната:" GridPane.rowIndex="1"/>
        <ComboBox fx:id="cmbRoom" prefWidth="250.0" promptText="Оберіть номер" GridPane.columnIndex="1"
                  GridPane.rowIndex="1"/>

        <Label text="Дата заїзду:" GridPane.rowIndex="2"/>
        <DatePicker fx:id="dpArrivalDate" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Дата виїзду:" GridPane.rowIndex="3"/>
        <DatePicker fx:id="dpDateLeaving" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Депозит (грн):" GridPane.rowIndex="4"/>
        <TextField fx:id="fieldDeposit" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <rowConstraints>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
        </rowConstraints>
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Button fx:id="btnCancel" styleClass="btn-secondary" text="Скасувати"/>
        <Button fx:id="btnSave" styleClass="btn-primary" text="Зберегти бронь"/>
    </HBox>
</VBox>
