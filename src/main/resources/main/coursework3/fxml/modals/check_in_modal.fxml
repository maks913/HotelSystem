<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="350.0" prefWidth="400.0" styleClass="content-area" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.coursework3.controllers.modals.CheckInController">
    <stylesheets>
        <URL value="@../../css/style.css"/>
    </stylesheets>
    <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0"
          AnchorPane.topAnchor="20.0">
        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Нове заселення (Check-in)"
               textAlignment="CENTER" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="18.0"/>
            </font>
        </Label>

        <GridPane hgap="10.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="120.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="250.0" minWidth="10.0" prefWidth="220.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints/>
            </rowConstraints>
            <Label text="Клієнт:" GridPane.rowIndex="0">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>
            <HBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <ComboBox fx:id="cmbClient" maxWidth="1.7976931348623157E308" promptText="Оберіть клієнта..."
                          HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAddNewClient" mnemonicParsing="false" styleClass="btn-action" text="+"/>
            </HBox>

            <Label text="Кімната:" GridPane.rowIndex="1">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>
            <ComboBox fx:id="cmbRoom" maxWidth="1.7976931348623157E308" promptText="Оберіть кімнату..."
                      GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Дата заїзду:" GridPane.rowIndex="2">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>
            <DatePicker fx:id="dpArrivalDate" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1"
                        GridPane.rowIndex="2"/>

            <Label text="Дата виїзду:" GridPane.rowIndex="3">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>
            <DatePicker fx:id="dpDateLeaving" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1"
                        GridPane.rowIndex="3"/>

            <Label text="Статус оплати:" GridPane.rowIndex="4">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>

            <ComboBox fx:id="cmbPaymentStatus" maxWidth="1.7976931348623157E308" promptText="Статус..."
                      GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="15.0" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
            <Button fx:id="btnCancel" cancelButton="true" mnemonicParsing="false" prefWidth="100.0"
                    styleClass="btn-cancel" text="Скасувати"/>
            <Button fx:id="btnSave" defaultButton="true" mnemonicParsing="false" prefWidth="100.0"
                    styleClass="btn-success" text="Зберегти"/>
        </HBox>
    </VBox>
</AnchorPane>
