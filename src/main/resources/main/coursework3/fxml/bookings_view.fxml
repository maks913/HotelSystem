<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.coursework3.controllers.BookingController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">

        <Label text="Управління бронюванням">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <TableView fx:id="bookingsTable" prefHeight="450.0" prefWidth="870.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colBookingId" prefWidth="70.0" text="ID Броні" />
                <TableColumn fx:id="colRoomNumber" prefWidth="110.0" text="Номер кімнати" />
                <TableColumn fx:id="colClientName" prefWidth="200.0" text="Клієнт" />
                <TableColumn fx:id="colArrivalDate" prefWidth="130.0" text="Дата заїзду" />
                <TableColumn fx:id="colDepartureDate" prefWidth="130.0" text="Дата виїзду" />
                <TableColumn fx:id="colDepositAmount" prefWidth="100.0" text="Депозит" />
                <TableColumn fx:id="colStatusArmor" prefWidth="110.0" text="Статус" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 5;">

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Пошук за ПІБ клієнта:" />
                <TextField fx:id="txtSearchClient" prefWidth="220.0" promptText="Введіть прізвище або ім'я..." />
                <CheckBox fx:id="checkShowCancelled" text="Показувати скасовані / завершені" />
            </HBox>

            <Pane HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button fx:id="btnEditBooking" mnemonicParsing="false" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Змінити параметри">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="btnCancelBooking" mnemonicParsing="false" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Скасувати бронь">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="btnConfirmBooking" mnemonicParsing="false" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Підтвердити">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </HBox>

        </HBox>
    </VBox>
</AnchorPane>