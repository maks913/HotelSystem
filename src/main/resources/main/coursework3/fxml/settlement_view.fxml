<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="520.0" prefWidth="950.0" styleClass="content-area" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.coursework3.controllers.SettlementController">
    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

        <Label text="Журнал проживання та виселення (Check-in / Check-out)" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <TableView fx:id="settlementsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colClient" prefWidth="200.0" text="ПІБ Клієнта" />
                <TableColumn fx:id="colRoom" prefWidth="100.0" text="Кімната" />
                <TableColumn fx:id="colArrival" prefWidth="120.0" text="Дата заїзду" />
                <TableColumn fx:id="colLeaving" prefWidth="120.0" text="Дата виїзду" />
                <TableColumn fx:id="colNights" prefWidth="100.0" text="К-сть ночей" />
                <TableColumn fx:id="colPaymentStatus" prefWidth="120.0" text="Статус оплати" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="15.0">

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Пошук за ПІБ клієнта:" />
                <TextField fx:id="txtSearchClient" prefWidth="230.0" promptText="Введіть прізвище або ім'я..." />
                <CheckBox fx:id="checkShowCompleted" text="Показувати виселених клієнтів (Архів)">
                    <font>
                        <Font size="13.0" />
                    </font>
                </CheckBox>
            </HBox>

            <Pane HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button fx:id="btnEditSettlement" mnemonicParsing="false" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 4;" text="⚙️ Змінити параметри">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="btnCheckOut" mnemonicParsing="false" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 4;" text="🚪 Виселити та розрахувати (Check-out)">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </HBox>

        </HBox>
    </VBox>
</AnchorPane>