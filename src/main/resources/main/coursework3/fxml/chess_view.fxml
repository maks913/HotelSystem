<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="950.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.coursework3.controllers.ChessController">

    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0"
          AnchorPane.topAnchor="15.0">

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <Label text="Шахматка номерного фонду" textFill="#2c3e50">
                <font>
                    <Font name="System Bold" size="18.0"/>
                </font>
            </Label>

            <Pane HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <ComboBox fx:id="comboMonth" prefWidth="130.0" promptText="Місяць"/>
                <ComboBox fx:id="comboYear" prefWidth="100.0" promptText="Рік"/>
                <Button fx:id="btnPrint" mnemonicParsing="false" styleClass="btn-action" text="📊 Фінансовий звіт"/>
                <Button fx:id="btnOpReport" mnemonicParsing="false" styleClass="btn-action" text="🏨 Операційний звіт"/>
                <Button fx:id="btnBusinessReport" mnemonicParsing="false" styleClass="btn-action" text="🏨 Розгорнутий звіт" />
            </HBox>
        </HBox>

        <HBox spacing="20.0" style="-fx-padding: 2 0;">
            <Label text="Статус:" style="-fx-font-weight: bold;"/>
            <Label style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" text="● Вільна"/>
            <Label style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;" text="● Зайнята"/>
            <Label style="-fx-text-fill: #f1c40f; -fx-font-weight: bold;" text="● Заброньована"/>
            <Label style="-fx-text-fill: #95a5a6; -fx-font-weight: bold;" text="● Ремонт"/>
        </HBox>

        <ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent;">
            <GridPane fx:id="chessGrid" gridLinesVisible="true" style="-fx-background-color: white;">
            </GridPane>
        </ScrollPane>

    </VBox>
</AnchorPane>