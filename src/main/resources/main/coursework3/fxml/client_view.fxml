<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="520.0" prefWidth="680.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.coursework3.controllers.ClientController">

    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0"
          AnchorPane.topAnchor="20.0">
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <Label text="Управління клієнтами" textFill="#2c3e50">
                <font>
                    <Font name="System Bold" size="18.0"/>
                </font>
            </Label>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                <TextField fx:id="searchField" prefWidth="200.0" promptText ="Пошук за ПІБ..."/>
                <Button fx:id="btnAddClient" mnemonicParsing="false" styleClass="btn-action"
                        text="➕ Додати клієнта"/>
            </HBox>
        </HBox>

        <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="40.0" text="ID"/>
                <TableColumn fx:id="colPib" prefWidth="200.0" text="ПІБ Клієнта"/>
                <TableColumn fx:id="colPassportSeria" prefWidth="60.0" text="Серія"/>
                <TableColumn fx:id="colPassportNumber" prefWidth="90.0" text="Номер пасп."/>
                <TableColumn fx:id="colPhone" prefWidth="120.0" text="Телефон"/>
                <TableColumn fx:id="colBirthday" prefWidth="100.0" text="Дата народж."/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</AnchorPane>